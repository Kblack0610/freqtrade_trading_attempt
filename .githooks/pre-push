#!/usr/bin/env bash
# Offline checks before a push; CI runs the same ones again as the authority.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git config --get core.hooksPath >/dev/null 2>&1 && command -v git-lfs >/dev/null 2>&1 && [ -f .gitattributes ]; then git lfs pre-push "$@"; fi
ci/ruff.sh check lab web ci user_data/strategies
